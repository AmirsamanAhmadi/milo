# Local development defaults. Copy to .env when changing these settings.
MILO_PUBLIC_URL=https://localhost:8080
MILO_BIND_ADDRESS=127.0.0.1
MILO_PORT=8080
MILO_PREVIEW_PORT=8081
# Optional New Zealand job search; server-side credentials from developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional paid SEEK searches via Apify. Excluded from combined searches.
APIFY_TOKEN=
# Optional AI assessment, CV tailoring and cover letters. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional administrator-approved OpenAI-compatible local server.
# Example: http://host.docker.internal:11434/v1
LOCAL_AI_URL=
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
# Read-only mailbox OAuth applications; never enter mailbox passwords.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Mount trusted certificate and private key as certs/cert.pem and certs/key.pem.
