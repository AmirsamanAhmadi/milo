# Local development defaults. Copy to .env when changing these settings.
MILO_PUBLIC_URL=https://localhost:8080
MILO_BIND_ADDRESS=127.0.0.1
MILO_PORT=8080
MILO_PREVIEW_PORT=8081
# Optional New Zealand job search; server-side credentials from developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional paid SEEK searches via Apify. Excluded from combined searches.
APIFY_TOKEN=
# Mount trusted certificate and private key as certs/cert.pem and certs/key.pem.
